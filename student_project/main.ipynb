
from students import generate_students
from analysis import calculate_age, calculate_statistics
import os

# Generate students
students = generate_students()

# Calculate ages
for student in students:
    student["age"] = calculate_age(
        student["birth_year"],
        student["birth_month"],
        student["birth_day"]
    )

# Display student data
print("STUDENT DATA")
print("--------------------")

for student in students:
    print("ID:", student["id"])
    print("Birth date:",
          student["birth_day"], "/",
          student["birth_month"], "/",
          student["birth_year"])
    print("Grades:", student["grades"])
    print("Age:", student["age"])
    print("Average:", round(student["average"], 2))
    print("--------------------")

# Calculate statistics
mean, median, sd, minimum, maximum, mean_age = calculate_statistics(students)

print("CLASS STATISTICS")
print("Mean:", round(mean, 2))
print("Median:", round(median, 2))
print("Standard deviation:", round(sd, 2))
print("Minimum average:", round(minimum, 2))
print("Maximum average:", round(maximum, 2))
print("Mean age:", round(mean_age, 2))

# Create results folder if it doesn't exist
if not os.path.exists("results"):
    os.mkdir("results")

# Save the report
file = open("results/report.txt", "w")

file.write("CLASS REPORT\n")
file.write("--------------------\n")
file.write("Number of students: 10\n\n")
file.write("Mean: " + str(round(mean, 2)) + "\n")
file.write("Median: " + str(round(median, 2)) + "\n")
file.write("Standard deviation: " + str(round(sd, 2)) + "\n")
file.write("Minimum average: " + str(round(minimum, 2)) + "\n")
file.write("Maximum average: " + str(round(maximum, 2)) + "\n")
file.write("Mean age: " + str(round(mean_age, 2)) + "\n")

file.close()

print("Report saved successfully!")
